  "abilities": [
    {
      "name": "Mordisco",
      "description": "Un mordisco directo para abrir presión si te quedas demasiado tiempo frente a ella.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Combo de 3 mordidas",
      "description": "Encadena varias mordidas cortas si detecta que sigues atrapado delante de ella.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Patada lateral",
      "description": "Gira el cuerpo para cazar a quien intenta rodearla o pegar desde el costado.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Golpe corporal",
      "description": "Empuja o deja caer todo el cuerpo para romper el espacio corto y castigar bloqueos tardíos.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Spray ácido",
      "description": "Escupe ácido para cerrar rutas de escape y seguir dañando el suelo durante unos segundos.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Embestida sin cabeza",
      "description": "Tras perder la cabeza se lanza en línea recta con el cuerpo, cubriendo mucha más distancia que en su fase normal.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Spray ácido sin cabeza",
      "description": "Expulsa un chorro ácido errático durante la fase sin cabeza y deja daño residual si te quedas en la línea.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
