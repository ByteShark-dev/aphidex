  "bossPhases": [
    {
      "id": "phase1",
      "label": "Fase 1",
      "startsAtHealthPct": 100,
      "trigger": "Comienza el encuentro.",
      "summary": "La Broodmother abre el combate con un patrón relativamente limpio de mordidas, saltos y embestidas laterales.",
      "aggressionChange": "Presión alta, pero todavía deja ventanas claras tras sus ataques grandes.",
      "newPatterns": [
        "Alterna entre mordida cargada y salto para comprobar si respondes siempre igual."
      ],
      "abilities": [
        {
          "name": "Mordida cargada",
          "description": "La primera gran amenaza del encuentro si te quedas delante demasiado tiempo.",
          "blockable": true,
          "breaksGuard": true,
          "staggers": true
        },
        {
          "name": "Ataque saltando",
          "description": "Sirve para retomar la distancia que el jugador acaba de abrir.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        }
      ],
      "specialTraits": [
        "Recibe muy poco daño de monturas e insectos aliados."
      ]
    },
    {
      "id": "phase2",
      "label": "Fase 2",
      "startsAtHealthPct": 66,
      "trigger": "La vida baja aproximadamente a dos tercios.",
      "summary": "Empieza a usar los proyectiles ácidos con mucha más frecuencia y castiga mejor cualquier retirada desordenada.",
      "aggressionChange": "Más frecuencia de ataques y menos tiempo libre entre patrones.",
      "newPatterns": [
        "Encadena proyectiles ácidos después de obligarte a bloquear una entrada frontal.",
        "Su embestida lateral aparece con más frecuencia para cortar reposicionamientos."
      ],
      "abilities": [
        {
          "name": "Embestida lateral",
          "description": "Se vuelve mucho más importante cuando intentas reposicionarte en esta fase.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        },
        {
          "name": "Proyectiles ácidos",
          "description": "La amenaza nueva más constante de la segunda fase.",
          "blockable": false,
          "breaksGuard": false,
          "staggers": false
        }
      ],
      "inflictsEffects": [
        "sour"
      ]
    },
    {
      "id": "phase3",
      "label": "Fase 3",
      "startsAtHealthPct": 33,
      "trigger": "La vida cae al tercio final.",
      "summary": "La fase final mezcla todas sus herramientas con la cadencia más agresiva del combate y casi no permite reiniciar el ritmo.",
      "aggressionChange": "Máxima agresividad y ventanas de castigo muy cortas.",
      "newPatterns": [
        "Alterna saltos, mordidas cargadas y proyectiles con mucho menos tiempo entre una acción y otra.",
        "Castiga mejor cualquier intento de curarte a media distancia."
      ],
      "abilities": [
        {
          "name": "Combo de 3 mordidas",
          "description": "Se vuelve mucho más opresivo cuando ya casi no deja respirar entre cadenas.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": false
        },
        {
          "name": "Proyectiles ácidos",
          "description": "Aseguran que incluso retirarte siga siendo peligroso.",
          "blockable": false,
          "breaksGuard": false,
