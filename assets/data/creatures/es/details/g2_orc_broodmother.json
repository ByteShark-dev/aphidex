    {
      "name": "Mordisco",
      "description": "Un ataque directo para mantenerte delante de ella y medir tu primer bloqueo.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Combo de 3 mordidas",
      "description": "Una secuencia corta y rápida para castigar respuestas prematuras o curaciones codiciosas.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Mordisco cargado",
      "description": "Retrasa un instante la animación antes de descargar un golpe mucho más duro.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Ataque en salto",
      "description": "Salta para volver a caer encima del objetivo y recuperar de inmediato la iniciativa.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Embestida lateral",
      "description": "Un cambio brusco de ángulo para castigar desplazamientos demasiado obvios hacia los costados.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Proyectiles sour",
      "description": "Escupe proyectiles ácidos para seguir forzándote a moverte incluso cuando logras abrir distancia.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
