  "inflicts": [
    "Daño cortante en mordisco y carga; daño contundente en golpe lateral y sacudida."
  ],
  "abilities": [
    {
      "name": "Mordisco",
      "description": "Un mordisco básico y bloqueable con el que abre gran parte de sus intercambios cuerpo a cuerpo.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Carga en carrera",
      "description": "Se prepara y luego se lanza directamente hacia delante. Puede iniciar este ataque desde cierta distancia.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Golpe lateral",
      "description": "Tiembla un momento y gira el costado para embestir. Si no lo bloqueas perfecto, rompe la guardia.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": false
    },
    {
      "name": "Sacudida trasera",
      "description": "Solo lo usa si el jugador está encima. Salta y sacude su parte trasera para golpear varias veces el área cercana.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Rugido",
      "description": "Se reafirma, ruge y recupera salud durante unos segundos mientras reduce acumulación de veneno."
    },
    {
      "name": "Postura defensiva",
      "description": "Esconde la cabeza en el caparazón y avanza lentamente, volviéndose inmune a ataques ligeros frontales hasta que la interrumpes con un cargado."
    }
  ],
