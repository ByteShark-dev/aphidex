  "inflicts": [
    "Todos sus ataques aplican veneno; sus movimientos más fuertes dejan una acumulación muy peligrosa si fallas el bloqueo."
  ],
  "abilities": [
    {
      "name": "Mordisco",
      "description": "Un mordisco básico pero muy dañino.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Combo de 5 mordidas",
      "description": "Encadena una larga serie de mordidas rápidas. Cada impacto añade 20 de acumulación de veneno.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Mordisco cargado",
      "description": "Ruge, se inclina y se lanza con un golpe fuerte que rompe la guardia si no lo bloqueas perfecto.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": false
    },
    {
      "name": "Ataque en salto",
      "description": "Salta y cae encima del jugador. Incluso bloqueado, tambalea al objetivo.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Riposte",
      "description": "Adopta una postura defensiva y, si recibe cualquier daño, responde con una mordida instantánea que tambalea y arrastra al jugador hacia ella.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    }
  ],
