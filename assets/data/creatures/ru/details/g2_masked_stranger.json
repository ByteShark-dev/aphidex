  "bossPhases": [
    {
      "id": "phase1",
      "label": "Фаза 1",
      "startsAtHealthPct": 100,
      "trigger": "Начало боя.",
      "summary": "Он начинает бой в основном физическим давлением: быстрыми атаками, короткими сериями и прыжком, чтобы снова закрыть дистанцию.",
      "aggressionChange": "Темп уже высокий, но между сериями ещё остаются понятные паузы."
    },
    {
      "id": "phase2",
      "label": "Фаза 2",
      "startsAtHealthPct": 66,
      "trigger": "Его здоровье опускается примерно до двух третей.",
      "summary": "Он начинает вплетать острый взрыв в крутящиеся серии, вынуждая двигаться и наказывая за предсказуемые ответы.",
      "aggressionChange": "Более высокая частота атак и более короткие окна для наказания.",
      "newPatterns": [
        "Он чередует острое давление по площади и вращения, наказывая и за стоящий блок, и за уходы в сторону."
      ]
    },
    {
      "id": "phase3",
      "label": "Фаза 3",
      "startsAtHealthPct": 33,
      "trigger": "Его здоровье падает до последней трети.",
      "summary": "Финальная фаза объединяет его длинные серии, прыжковое давление и острые взрывы, оставляя меньше всего передышки за весь бой.",
      "aggressionChange": "Максимальная агрессия и добивающие паттерны, рассчитанные на любое позднее ошибочное действие.",
      "newPatterns": [
        "Длинные серии чаще начинаются сразу после прыжка или острого взрыва."
      ]
    }
  ],
