  "abilities": [
    {
      "name": "Укус",
      "description": "Лобовой укус, которым он начинает давление вблизи.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Комбо из 3 укусов",
      "description": "Он связывает несколько коротких укусов подряд, наказывая за то, что вы не ушли с его фронта вовремя.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Боковой удар",
      "description": "Он бьёт в сторону, пытаясь поймать тех, кто обходит его по флангу.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Безголовый таран",
      "description": "Он бросает всё тело вперёд в резком таране, который легко недооценить, если расслабиться.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    }
  ],
