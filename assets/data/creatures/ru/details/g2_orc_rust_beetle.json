  "abilities": [
    {
      "name": "Укус",
      "description": "Короткий укус, которым он наказывает, если уже слишком надолго прижал вас к себе.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Ближний распыл",
      "description": "Он выпускает едкое облако вблизи, чтобы не дать спокойно наказать его в лоб.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Едкий выстрел",
      "description": "Он плюётся едким снарядом со средней дистанции, продолжая наносить урон во время перестроения.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Выстрел вверх",
      "description": "Он выпускает выстрел по высокой дуге, чтобы продолжать мешать даже тогда, когда игрок пытается держать высоту.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
