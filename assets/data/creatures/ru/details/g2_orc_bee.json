    },
    {
      "name": "Комбо-жало",
      "description": "Она соединяет несколько уколов жалом подряд, зависая на вашей высоте.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Заряженное жало",
      "description": "Она на мгновение отходит назад, а затем вонзает жало с заметно большей силой.",
