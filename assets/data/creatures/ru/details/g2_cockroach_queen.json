  "abilities": [
    {
      "name": "Укус",
      "description": "Прямой укус, которым она начинает давление, если игрок слишком долго стоит перед ней.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Комбо из 3 укусов",
      "description": "Она связывает несколько коротких укусов подряд, если видит, что игрок всё ещё зажат перед ней.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Боковой удар",
      "description": "Она резко разворачивается в сторону, чтобы поймать тех, кто пытается обойти её или наказать с фланга.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Удар корпусом",
      "description": "Она вкладывает в удар всё тело, ломая ближнюю дистанцию и наказывая за поздний блок.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Кислотный распыл",
      "description": "Она выплёвывает кислоту, перекрывая пути отхода и оставляя на полу опасную зону на несколько секунд.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Безголовый таран",
      "description": "Потеряв голову, она бросает тело по прямой, покрывая заметно большую дистанцию, чем в обычной фазе.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Безголовый кислотный распыл",
      "description": "В безголовой фазе она выпускает более хаотичную кислотную струю и оставляет остаточный урон, если вы стоите на линии.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
