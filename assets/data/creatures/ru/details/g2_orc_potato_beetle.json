  "abilities": [
    {
      "name": "Укус",
      "description": "Короткая атака жвалами, которой он начинает давление, когда уже подошёл вплотную.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Бегущий таран",
      "description": "Он разгоняется по прямой и врезается всей массой, мгновенно сокращая дистанцию.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Боковой удар",
      "description": "Он разворачивает корпус в сторону, наказывая тех, кто пытается слишком рано обойти его сбоку.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Задняя встряска",
      "description": "Он резко брыкается назад, сбивая с позиции всех, кто слишком долго сидит у него за спиной.",
      "blockable": true,
      "breaksGuard": true,
