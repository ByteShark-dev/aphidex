  "abilities": [
    {
      "name": "Разрез",
      "description": "Быстрый удар когтями, которым она открывает размен и удерживает игрока перед собой.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Комбо из 3 ударов когтями",
      "description": "Короткая и быстрая серия, предназначенная для наказания нервных ответов вблизи.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Заряженный удар",
      "description": "Она на миг задерживает удар, а затем наносит куда более тяжёлую и опасную атаку.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Наскок",
      "description": "Она внезапно бросается вперёд, чтобы снова закрыть дистанцию, которую игрок только что открыл.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Вертикальная волна",
      "description": "Она резко бьёт по земле, покрывая ближайшее пространство опасной ударной волной.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": true
    }
  ],
