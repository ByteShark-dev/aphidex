  "abilities": [
    {
      "name": "Укус",
      "description": "Прямой укус, которым она удерживает игрока перед собой и проверяет первый блок.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Комбо из 3 укусов",
      "description": "Короткая быстрая серия, предназначенная для наказания раннего ответа или жадного лечения.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Заряженный укус",
      "description": "Она на миг задерживается, а затем наносит куда более тяжёлый укус.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Прыжковая атака",
      "description": "Она прыгает и обрушивается обратно на цель, мгновенно возвращая себе инициативу.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Боковой выпад",
      "description": "Резкая смена угла, которой она наказывает слишком очевидные уходы в сторону.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Sour-снаряды",
      "description": "Она выплёвывает кислые снаряды, продолжая заставлять игрока двигаться даже после того, как тот открыл дистанцию.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
