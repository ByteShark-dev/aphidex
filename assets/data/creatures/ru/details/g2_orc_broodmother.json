  "bossPhases": [
    {
      "id": "phase1",
      "label": "Фаза 1",
      "startsAtHealthPct": 100,
      "trigger": "Начало боя.",
      "summary": "Broodmother начинает бой сравнительно чистым набором укусов, прыжков и боковых выпадов.",
      "aggressionChange": "Давление уже высокое, но после крупных атак ещё остаются понятные окна.",
      "newPatterns": [
        "Она чередует заряженный укус и прыжок, проверяя, не отвечаете ли вы всегда одинаково."
      ],
      "abilities": [
        {
          "name": "Заряженный укус",
          "description": "Первая серьёзная угроза боя, если слишком долго оставаться перед ней.",
          "blockable": true,
          "breaksGuard": true,
          "staggers": true
        },
        {
          "name": "Атака в прыжке",
          "description": "Используется, чтобы снова закрыть дистанцию, которую только что открыл игрок.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        }
      ],
      "specialTraits": [
        "Она получает очень мало урона от ездовых насекомых и союзных существ."
      ]
    },
    {
      "id": "phase2",
      "label": "Фаза 2",
      "startsAtHealthPct": 66,
      "trigger": "Её здоровье падает примерно до двух третей.",
      "summary": "Она начинает заметно чаще использовать кислые снаряды и гораздо лучше наказывает беспорядочные отходы.",
      "aggressionChange": "Больше частота атак и значительно меньше свободного времени между паттернами.",
      "newPatterns": [
        "Она связывает кислые снаряды после того, как заставляет игрока блокировать лобовой заход.",
        "Боковой выпад появляется чаще, чтобы перерезать перестроение."
      ],
      "abilities": [
        {
          "name": "Боковой выпад",
          "description": "В этой фазе он становится куда важнее, когда игрок пытается перестроиться.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        },
        {
          "name": "Кислые снаряды",
          "description": "Главная новая стабильная угроза второй фазы.",
          "blockable": false,
          "breaksGuard": false,
          "staggers": false
        }
      ],
      "inflictsEffects": [
        "sour"
      ]
    },
    {
      "id": "phase3",
      "label": "Фаза 3",
      "startsAtHealthPct": 33,
      "trigger": "Её здоровье опускается до последней трети.",
      "summary": "Финальная фаза смешивает все её инструменты на самой агрессивной скорости боя и почти не позволяет сбросить темп.",
      "aggressionChange": "Максимальная агрессия и очень короткие окна для наказания.",
      "newPatterns": [
        "Она чередует прыжки, заряженные укусы и снаряды с куда меньшими паузами между действиями.",
        "Она куда надёжнее наказывает любые попытки лечиться на средней дистанции."
      ],
      "abilities": [
        {
          "name": "Комбо из 3 укусов",
          "description": "Он становится гораздо более удушающим, когда между сериями почти не остаётся передышки.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": false
        },
        {
          "name": "Кислые снаряды",
          "description": "Они делают опасным даже простой отход назад.",
          "blockable": false,
          "breaksGuard": false,
          "staggers": false
        }
      ],
      "inflictsEffects": [
        "sour"
      ]
    }
