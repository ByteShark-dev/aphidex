  "inflicts": [
    "Кислотный распыл накладывает горение, а самые тяжёлые атаки корпусом считаются дробящим уроном."
  ],
  "abilities": [
    {
      "name": "Укус",
      "description": "Прямой укус, которым она начинает давление, если вы слишком долго стоите перед ней.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Комбо из 3 укусов",
      "description": "Она связывает несколько коротких укусов подряд, если видит, что вы всё ещё зажаты перед ней.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Боковой удар",
      "description": "Она разворачивает корпус в сторону, чтобы поймать тех, кто пытается обойти её или бить с фланга.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Удар корпусом",
      "description": "Она обрушивает или вталкивает в игрока всё тело, чтобы раздавить цель и сломать ближнюю дистанцию.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Кислотный распыл",
      "description": "Она выплёвывает кислоту, перекрывая пути отхода и покрывая пол остаточным уроном.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Безголовый таран",
      "description": "После возрождения она бросается вперёд ещё яростнее в прямом безголовом таране.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Безголовый кислотный распыл",
      "description": "В безголовом отрезке тело выпускает более жестокий кислотный распыл, который всё ещё накладывает горение и сильнее наказывает медленное лечение.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
