      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "3-Hit Combo Bite",
      "description": "It chains several short bites to punish you if you fail to leave its front arc in time.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Side Kick",
      "description": "It kicks sideways to catch players circling around it.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Headless Ram",
      "description": "It throws its whole body forward in a sudden ram that is easy to misread if you get complacent.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    }
