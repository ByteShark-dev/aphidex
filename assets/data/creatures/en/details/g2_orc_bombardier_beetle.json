    },
    {
      "name": "Close-Range Spray",
      "description": "It spits acid at close range to open space and force you backward.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Ranged Shot",
      "description": "It fires a straight acid projectile to control mid-range spacing.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "3 Upwards Shot",
      "description": "It launches several acid shots upward so they rain down and shrink the safe area even more.",
