  "bossPhases": [
    {
      "id": "phase1",
      "label": "Phase 1",
      "startsAtHealthPct": 100,
      "trigger": "The fight begins.",
      "summary": "The Broodmother opens with a relatively clean pattern of bites, jumps, and side lunges.",
      "aggressionChange": "High pressure, but it still leaves clear windows after its larger attacks.",
      "newPatterns": [
        "It alternates charged bites and jumps to test whether you always answer the same way."
      ],
      "abilities": [
        {
          "name": "Charged Bite",
          "description": "The first major threat of the fight if you stay in front too long.",
          "blockable": true,
          "breaksGuard": true,
          "staggers": true
        },
        {
          "name": "Jump Attack",
          "description": "Used to reclaim the distance the player just created.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        }
      ],
      "specialTraits": [
        "It takes very little damage from buggies and allied insects."
      ]
    },
    {
      "id": "phase2",
      "label": "Phase 2",
      "startsAtHealthPct": 66,
      "trigger": "Her health drops to roughly two thirds.",
      "summary": "She begins using acidic projectiles much more often and punishes sloppy disengages far better.",
      "aggressionChange": "More attack frequency and much less free time between patterns.",
      "newPatterns": [
        "It chains acidic projectiles after forcing you to block a frontal approach.",
        "Its side lunge appears more often to cut off repositioning."
      ],
      "abilities": [
        {
          "name": "Side Lunge",
          "description": "It becomes much more important once you start trying to reposition in this phase.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": true
        },
        {
          "name": "Sour Projectiles",
          "description": "The most consistent new threat in phase two.",
          "blockable": false,
          "breaksGuard": false,
          "staggers": false
        }
      ],
      "inflictsEffects": [
        "sour"
      ]
    },
    {
      "id": "phase3",
      "label": "Phase 3",
      "startsAtHealthPct": 33,
      "trigger": "Her health falls into the final third.",
      "summary": "The final phase mixes all of her tools at the fight's most aggressive cadence and barely allows the tempo to reset.",
      "aggressionChange": "Maximum aggression and very short punish windows.",
      "newPatterns": [
        "It alternates jumps, charged bites, and projectiles with much less time between actions.",
        "It punishes any attempt to heal at mid-range far more reliably."
      ],
      "abilities": [
        {
          "name": "3-Combo Bite",
          "description": "It becomes far more oppressive once she barely leaves breathing room between chains.",
          "blockable": true,
          "breaksGuard": false,
          "staggers": false
        },
        {
          "name": "Sour Projectiles",
          "description": "They ensure that even backing away remains dangerous.",
          "blockable": false,
          "breaksGuard": false,
          "staggers": false
        }
      ],
      "inflictsEffects": [
        "sour"
      ]
    }
  ],
