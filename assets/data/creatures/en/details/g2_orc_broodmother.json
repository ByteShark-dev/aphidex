    },
    {
      "name": "Charged Bite",
      "description": "She delays for a moment before delivering a much heavier bite.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Jump Attack",
      "description": "She leaps and comes back down on the target to reclaim initiative immediately.",
      "blockable": true,
      "breaksGuard": false,
