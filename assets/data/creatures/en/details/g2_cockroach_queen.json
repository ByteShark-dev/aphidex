  "abilities": [
    {
      "name": "Bite",
      "description": "A direct bite used to open pressure if you stay in front of her for too long.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "3-Hit Combo Bite",
      "description": "She chains several short bites if she sees that you are still trapped in front of her.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Side Kick",
      "description": "She twists sideways to catch players trying to circle around or punish from the flank.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Body Slam",
      "description": "She throws her whole body into the attack to break close spacing and punish late blocks.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Acid Spray",
      "description": "She spits acid to close escape routes and leave damaging ground behind for a few seconds.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Headless Ram",
      "description": "After losing its head it throws its whole body forward in a straight rush, covering far more ground than in the normal phase.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Headless Acid Spray",
      "description": "It expels a wilder acid stream during the headless phase and leaves lingering damage if you stay in the line.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
