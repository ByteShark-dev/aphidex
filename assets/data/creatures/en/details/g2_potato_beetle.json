  "abilities": [
    {
      "name": "Bite",
      "description": "A basic blockable bite that opens many of its close-range exchanges.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Running Charge",
      "description": "It braces itself and then charges directly forward. It can start this attack from a fair distance away.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Side Hit",
      "description": "It shakes briefly and slams its side into the player. It breaks guard if the block is not perfect.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": false
    },
    {
      "name": "Back Buck",
      "description": "Used only if the player is standing on top of it. It bucks upward and repeatedly hits the area around its shell.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Roar",
      "description": "It braces itself, roars, and heals over several seconds while also cleansing venom buildup."
    },
    {
      "name": "Blocking Stance",
      "description": "It retracts its head into its shell and advances slowly, becoming immune to frontal light attacks until interrupted by a charged hit."
    }
  ],
