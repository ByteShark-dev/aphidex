  "specialTraits": [
    "Recruits 1 nearby Black Worker Ant.",
    "Can transport 12 hauling objects or 1 egg.",
    "Throws Tang and leaves a short corrosive puddle.",
    "Shares the 30-slot buggy inventory."
  ],
  "abilities": [
    {
      "name": "Recruit Black Worker Ant",
      "description": "Near a Black Worker Ant, it forces the ant to serve the player. The worker follows the mount and fights beside it. Costs 2 stamina bars."
    },
    {
      "name": "Tang Throw",
      "description": "Uses the black ant Tang attack to lob a short corrosive projectile that leaves an affected area behind."
    },
    {
      "name": "Mandible Bite",
      "description": "A short reliable attack used to keep pressure up."
    },
    {
      "name": "Mandible Combo",
      "description": "A series of chained hits once the victim stays in front of the mount."
    },
    {
      "name": "Heavy Charge",
      "description": "A sturdier charge than the red buggy version, used to open or finish fights while Tang blocks the retreat."
    }
  ],
