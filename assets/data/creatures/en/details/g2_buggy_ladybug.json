    "Clears Tang puddles with its water cannon.",
    "Has the highest health of all buggies.",
    "Can carry materials, but less than the ant buggies.",
    "Shares the 30-slot buggy inventory."
  ],
  "abilities": [
    {
      "name": "Heal",
      "description": "Performs a long animation and heals 160 health. Costs 3 stamina bars."
    },
    {
      "name": "Water Cannon",
      "description": "Fires water while the rider keeps moving. It holds 120 shots and can be reloaded at water sources or with a filled canteen."
    },
    {
      "name": "Shove",
      "description": "A body check that deals 92 busting damage, 20 stun, and also breaks tier 1 busting nodes. Costs 3 stamina bars."
    },
    {
      "name": "Water Burst",
      "description": "A short chain of shots used to harass flyers and clear contaminated ground."
    },
    {
      "name": "Front Sweep",
      "description": "A short close-range sweep used to push enemies back and reset the fight when you get boxed in."
    }
  ],
