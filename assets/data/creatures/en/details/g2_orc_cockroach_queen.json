  "abilities": [
    {
      "name": "Bite",
      "description": "A direct bite used to open pressure when you stay in front of her.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "3-Hit Combo Bite",
      "description": "She chains several short bites if she sees that you are still trapped in front of her.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Side Kick",
      "description": "She swings sideways to catch players trying to circle around or punish from the flank.",
      "blockable": true,
      "breaksGuard": false,
      "staggers": true
    },
    {
      "name": "Body Slam",
      "description": "She drops or throws her whole body forward to crush you and break close spacing.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Acid Spray",
      "description": "She spits acid to close escape paths and cover the floor with lingering damage.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    },
    {
      "name": "Headless Ram",
      "description": "After reviving, she throws herself forward in a more violent direct ram.",
      "blockable": true,
      "breaksGuard": true,
      "staggers": true
    },
    {
      "name": "Headless Acid Spray",
      "description": "During the headless stretch the body launches a nastier acid spray that still inflicts burning and punishes slow healing harder.",
      "blockable": false,
      "breaksGuard": false,
      "staggers": false
    }
  ],
